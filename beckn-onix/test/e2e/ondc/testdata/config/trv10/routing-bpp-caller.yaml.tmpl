routingRules:
  # Callbacks go to the BAP named in context.bap_uri.
  - version: "2.0.0"
    targetType: bap
    endpoints:
      - on_search
      - on_select
      - on_init
      - on_confirm
      - on_status
      - on_track
      - on_update
      - on_cancel
      - on_rating
      - on_support
